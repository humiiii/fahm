# Quran Foundation — server-only credentials. Never add NEXT_PUBLIC_ prefixes.
# New apps use prelive; use production only with approved production credentials.
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# Use legacy only if the Console lists the older umbrella `content` scope.
QF_CONTENT_SCOPE_MODE=granular

# Next.js expands dollar signs in environment files. Escape a literal $ as \$.
